{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkMusic",
  "version": "1.0.0",
  "identifier": "com.skmusic.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkMusic",
        "width": 360,
        "height": 660,
        "minWidth": 330,
        "minHeight": 580,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "maxWidth": 420,
        "maxHeight": 780,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
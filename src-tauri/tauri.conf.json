{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reproductor YouTube - Variados",
  "version": "1.0.0",
  "identifier": "com.tuusuario.reproductoryoutubevariados",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reproductor YouTube - Variados",
        "width": 430,
        "height": 860,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "maxWidth": 520,
        "maxHeight": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
